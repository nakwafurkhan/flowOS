# Copy to .env for local development; never put real secrets in Git.
# This file is a template only - .env is gitignored.

PORT=4000
ERPNEXT_BASE_URL=https://your-erpnext-domain.example
ERPNEXT_API_KEY=replace_me
ERPNEXT_API_SECRET=replace_me
# Milliseconds to wait before aborting an ERPNext HTTP request.
ERPNEXT_TIMEOUT_MS=5000
